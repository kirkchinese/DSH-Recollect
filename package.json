{
  "name": "@kirkchinese/dsh-recollect",
  "version": "0.3.0",
  "description": "Claude-Code-compatible memory for every model in DeepSeek Harness: layered CLAUDE.md/AGENTS.md instructions with @import and rules, a persistent MEMORY.md memory with full writing guidance, refresh on resume and compaction, optional recall, background extraction and consolidation.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "long-term-memory",
    "claude-md",
    "agents-md",
    "instructions",
    "recall",
    "bm25"
  ],
  "homepage": "https://github.com/kirkchinese/DSH-Recollect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirkchinese/DSH-Recollect.git"
  },
  "bugs": {
    "url": "https://github.com/kirkchinese/DSH-Recollect/issues"
  },
  "license": "MIT",
  "author": "kirkchinese",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "index.js",
    "lib/*.js",
    "lib/text/*.js",
    "cordis.patch.yml",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1 || 3.18.5-alpha.2 || 3.18.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:client": "node client/build.mjs"
  }
}
